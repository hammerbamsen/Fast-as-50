<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 1 Z2 - Grundtur 80</name>
    <description>Ren zone 2. Skal føles kedeligt. Fundamentet under alt andet — og den enkeltfaktor der bedst forudsiger hvor lidt VO2max falder med alderen.</description>
    <sportType>bike</sportType>
    <tags><tag name="z2"/><tag name="base"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.4500" PowerHigh="0.6200"/>
        <SteadyState Duration="1500" Power="0.6600">
            <textevent timeoffset="0" message="Zone 2. Du skal kunne tale hele vejen."/>
            <textevent timeoffset="900" message="Drik."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.7000" Cadence="100"/>
        <SteadyState Duration="1500" Power="0.6600">
            <textevent timeoffset="900" message="Drik igen."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.7000" Cadence="100"/>
        <Cooldown Duration="600" PowerLow="0.6200" PowerHigh="0.4000"/>
    </workout>
</workout_file>
