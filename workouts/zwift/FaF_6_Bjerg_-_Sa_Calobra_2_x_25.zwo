<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 6 Bjerg - Sa Calobra 2 x 25</name>
    <description>To gange med nedkørsel imellem. Kan du gentage en indsats? Det spørger Tour des Stations om syv gange.</description>
    <sportType>bike</sportType>
    <tags><tag name="bjerg"/><tag name="sacalobra"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.4500" PowerHigh="0.6800"/>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9500" OffPower="0.5500"/>
        <SteadyState Duration="300" Power="0.6200"/>
        <SteadyState Duration="1500" Power="0.8600" Cadence="72">
            <textevent timeoffset="750" message="Halvvejs"/>
            <textevent timeoffset="1320" message="Sidste 3"/>
        </SteadyState>
        <SteadyState Duration="720" Power="0.5500" Cadence="95">
            <textevent timeoffset="0" message="SPIS og DRIK. Du skal kunne det samme igen."/>
        </SteadyState>
        <SteadyState Duration="1500" Power="0.8600" Cadence="72">
            <textevent timeoffset="0" message="Samme watt. Ikke lavere."/>
            <textevent timeoffset="750" message="Her vil hovedet forhandle"/>
            <textevent timeoffset="1200" message="Sidste 5"/>
        </SteadyState>
        <SteadyState Duration="420" Power="0.5500"/>
        <Cooldown Duration="480" PowerLow="0.6000" PowerHigh="0.4000"/>
    </workout>
</workout_file>
