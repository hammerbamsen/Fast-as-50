<workout_file>
    <author>K. Hammerby / Fast as 50</author>
    <name>FaF 4 Tær - Over-unders 3 x 10</name>
    <description>2 min under / 1 min over, uden pause imellem. Laktatclearing mens du stadig arbejder — det gradienten kræver når den skifter.  Praksis-standard, men svag direkte evidens — ingen isoleret RCT mod lige tærskelintervaller. Fysiologisk logik er god.</description>
    <sportType>bike</sportType>
    <tags><tag name="taerskel"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.4500" PowerHigh="0.7000"/>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.0000" OffPower="0.5500"/>
        <SteadyState Duration="300" Power="0.6200"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.9500" OffPower="1.0500">
            <textevent timeoffset="0" message="BLOK 1"/>
        </IntervalsT>
        <SteadyState Duration="60" Power="0.9500"/>
        <SteadyState Duration="360" Power="0.5500"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.9500" OffPower="1.0500">
            <textevent timeoffset="0" message="BLOK 2"/>
        </IntervalsT>
        <SteadyState Duration="60" Power="0.9500"/>
        <SteadyState Duration="360" Power="0.5500"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.9500" OffPower="1.0600">
            <textevent timeoffset="0" message="BLOK 3"/>
        </IntervalsT>
        <SteadyState Duration="60" Power="0.9600"/>
        <Cooldown Duration="480" PowerLow="0.6000" PowerHigh="0.4000"/>
    </workout>
</workout_file>
