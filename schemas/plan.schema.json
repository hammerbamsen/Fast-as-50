{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fast-as-50/plan.schema.json",
  "title": "data/plan.json — programmer, uger og dage (kontrakt)",
  "description": "Kræver KUN de felter koden reelt læser (modules/programs.py, config.py, sessions/plan_view, index.html). additionalProperties: true overalt — skemaet fanger struktur-brud, ikke nye felter.",
  "type": "object",
  "required": [
    "programs",
    "athletes"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "updated": {
      "type": "string"
    },
    "programs": {
      "type": "object",
      "minProperties": 1,
      "description": "id -> program. programs.active_program() vælger efter dato: start <= i dag <= end.",
      "additionalProperties": {
        "$ref": "#/$defs/program"
      }
    },
    "athletes": {
      "type": "object",
      "required": [
        "kennet"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/athlete"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "program": {
      "type": "object",
      "required": [
        "start",
        "weeks"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "athletes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "totalWeeks": {
          "type": "integer",
          "minimum": 1
        },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/week"
          }
        },
        "races": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            },
            "additionalProperties": true
          }
        },
        "goals": {
          "type": "object"
        }
      }
    },
    "week": {
      "type": "object",
      "required": [
        "week",
        "start",
        "blockType",
        "ctlTarget"
      ],
      "additionalProperties": true,
      "properties": {
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "blockType": {
          "type": "string"
        },
        "ctlTarget": {
          "type": "number"
        },
        "tssTarget": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "athlete": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "birthYear": {
          "type": "integer"
        },
        "zones": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "thresholdSec": {
              "type": "number"
            },
            "ftpW": {
              "type": "number"
            },
            "runPct": {
              "type": "object"
            },
            "bikePct": {
              "type": "object"
            }
          }
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "weeks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "required": [
        "date",
        "entries"
      ],
      "additionalProperties": true,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "workout"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "libraryId": {
          "type": "string",
          "description": "Kælderpas-id fra data/bike_library.json (eller template-id fra workout_library.json)"
        },
        "done": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "workout": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "moving_time": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "workout_doc": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "description": "null = fridag/notat-entry (16 stk. 7/9-2026); ellers Intervals-lignende workout"
        }
      }
    }
  }
}
