{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fast-as-50/bike_library.schema.json",
  "title": "data/bike_library.json — kælderpas (kontrakt)",
  "description": "Felter som modules/bike_library.py læser: workouts[].id/category/load/erg/steps, step.type/min/from/to/pct/n/steps/text. Watt-tal og pas må aldrig ændres ad hoc — se CLAUDE.md.",
  "type": "object",
  "required": [
    "meta",
    "workouts"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": [
            "string",
            "number"
          ]
        },
        "categories": {
          "type": [
            "object",
            "array"
          ],
          "description": "id -> visningsnavn (objekt) — historisk også array"
        },
        "rules": {}
      }
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "load",
          "steps"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "load": {
            "type": "string",
            "enum": [
              "let",
              "moderat",
              "haard"
            ]
          },
          "erg": {
            "type": "boolean"
          },
          "est_min": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "steady",
            "ramp",
            "reps",
            "free"
          ]
        },
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pct": {
          "type": "number"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "steady"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "pct"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ramp"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "from",
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "free"
              }
            }
          },
          "then": {
            "required": [
              "min"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reps"
              }
            }
          },
          "then": {
            "required": [
              "n",
              "steps"
            ]
          }
        }
      ]
    }
  }
}
